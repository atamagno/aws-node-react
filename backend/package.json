{
  "name": "nodejs-practice",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "prod": "cross-env NODE_ENV=production ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "ts-node esbuild.config.ts",
    "build:dev": "esbuild src/index.ts --bundle --platform=node --target=node20 --sourcemap --outfile=dist/index.js --define:process.env.NODE_ENV='\"development\"'",
    "build:prod": "esbuild src/index.ts --bundle --platform=node --target=node20 --minify --outfile=dist/index.js --define:process.env.NODE_ENV='\"production\"'",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --fix",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "cd .. && husky backend/.husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@jest/globals": "^30.2.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/aws-lambda": "^8.10.156",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.9.1",
    "@types/pino": "^7.0.4",
    "aws-sdk-client-mock": "^4.1.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "js-yaml": "^4.1.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.935.0",
    "@aws-sdk/client-dynamodb": "^3.913.0",
    "@aws-sdk/lib-dynamodb": "^3.913.0",
    "@serverless/utils": "^6.15.0",
    "aws-jwt-verify": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
