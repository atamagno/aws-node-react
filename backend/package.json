{
  "name": "nodejs-practice",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "prod": "cross-env NODE_ENV=production ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "ts-node esbuild.config.ts",
    "build:dev": "esbuild src/index.ts --bundle --platform=node --target=node20 --sourcemap --outfile=dist/index.js --define:process.env.NODE_ENV='\"development\"'",
    "build:prod": "esbuild src/index.ts --bundle --platform=node --target=node20 --minify --outfile=dist/index.js --define:process.env.NODE_ENV='\"production\"'",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --fix",
    "check-format": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@serverless/utils": "^6.15.0",
    "@types/aws-lambda": "^8.10.156",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.9.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.11",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.913.0",
    "@aws-sdk/lib-dynamodb": "^3.913.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "uuid": "^13.0.0"
  }
}
